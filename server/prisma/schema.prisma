// SEN371 Board Game Store — Prisma schema
// Owner: Member C (Database Integration)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique @db.VarChar(20)
  users User[]

  @@map("roles")
}

model Category {
  id       Int               @id @default(autoincrement())
  name     String            @unique @db.VarChar(100)
  slug     String            @unique @db.VarChar(100)
  products ProductCategory[]

  @@map("categories")
}

model User {
  id           Int      @id @default(autoincrement())
  roleId       Int      @map("role_id")
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  firstName    String   @map("first_name") @db.VarChar(100)
  lastName     String   @map("last_name") @db.VarChar(100)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  role          Role           @relation(fields: [roleId], references: [id])
  addresses     Address[]
  cartItems     CartItem[]
  orders        Order[]
  reviews       Review[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Address {
  id            Int     @id @default(autoincrement())
  userId        Int     @map("user_id")
  line1         String  @db.VarChar(255)
  line2         String? @db.VarChar(255)
  city          String  @db.VarChar(100)
  provinceState String  @map("province_state") @db.VarChar(100)
  postalCode    String  @map("postal_code") @db.VarChar(20)
  country       String  @db.VarChar(100)
  isDefault     Boolean @default(false) @map("is_default")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@map("addresses")
}

model Product {
  id               Int      @id @default(autoincrement())
  title            String   @db.VarChar(255)
  slug             String   @unique @db.VarChar(255)
  description      String?
  publisher        String?  @db.VarChar(150)
  designer         String?  @db.VarChar(150)
  minPlayers       Int      @map("min_players") @db.SmallInt
  maxPlayers       Int      @map("max_players") @db.SmallInt
  playTimeMinutes  Int      @map("play_time_minutes") @db.SmallInt
  minAge           Int      @map("min_age") @db.SmallInt
  complexityRating Decimal  @map("complexity_rating") @db.Decimal(2, 1)
  price            Decimal  @db.Decimal(10, 2)
  imageUrl         String?  @map("image_url") @db.VarChar(500)
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  categories ProductCategory[]
  inventory  Inventory?
  cartItems  CartItem[]
  orderItems OrderItem[]
  reviews    Review[]

  @@index([title])
  @@map("products")
}

model ProductCategory {
  productId  Int @map("product_id")
  categoryId Int @map("category_id")

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

model Inventory {
  productId        Int      @id @map("product_id")
  quantityOnHand   Int      @default(0) @map("quantity_on_hand")
  reorderThreshold Int      @default(5) @map("reorder_threshold")
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("inventory")
}

model CartItem {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  productId Int      @map("product_id")
  quantity  Int
  addedAt   DateTime @default(now()) @map("added_at") @db.Timestamptz(6)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@map("cart_items")
}

enum OrderStatus {
  pending
  paid
  shipped
  delivered
  cancelled
}

model Order {
  id          Int         @id @default(autoincrement())
  userId      Int         @map("user_id")
  addressId   Int         @map("address_id")
  status      OrderStatus @default(pending)
  subtotal    Decimal     @db.Decimal(10, 2)
  shippingFee Decimal     @default(0) @map("shipping_fee") @db.Decimal(10, 2)
  total       Decimal     @db.Decimal(10, 2)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  user    User        @relation(fields: [userId], references: [id])
  address Address     @relation(fields: [addressId], references: [id])
  items   OrderItem[]
  payment Payment?

  @@index([userId, createdAt(sort: Desc)])
  @@map("orders")
}

model OrderItem {
  id           Int     @id @default(autoincrement())
  orderId      Int     @map("order_id")
  productId    Int     @map("product_id")
  productTitle String  @map("product_title") @db.VarChar(255)
  unitPrice    Decimal @map("unit_price") @db.Decimal(10, 2)
  quantity     Int     @db.SmallInt

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

enum PaymentMethod {
  card
  eft
}

enum PaymentStatus {
  pending
  completed
  failed
  refunded
}

model Payment {
  id             Int           @id @default(autoincrement())
  orderId        Int           @unique @map("order_id")
  method         PaymentMethod
  status         PaymentStatus
  transactionRef String?       @map("transaction_ref") @db.VarChar(255)
  paidAt         DateTime?     @map("paid_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Review {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  productId Int      @map("product_id")
  rating    Int      @db.SmallInt
  comment   String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
  @@map("reviews")
}