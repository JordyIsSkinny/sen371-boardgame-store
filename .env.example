# ---- Database ----
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# ---- Authentication ----
JWT_SECRET="replace-with-64-char-random-string"
REFRESH_TOKEN_SECRET="replace-with-different-64-char-random-string"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# ---- Server ----
PORT=3000
NODE_ENV="development"
# Comma-separated allowlist. Both a local dev client and the deployed
# GitHub Pages site need to work at once during M4.
CLIENT_ORIGIN="http://localhost:5173,https://<org>.github.io"

# ---- Client ----
VITE_API_BASE_URL="http://localhost:3000/api/v1"